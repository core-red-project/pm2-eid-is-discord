{
  "name": "pm2-eid-dashboard",
  "version": "2.0.0",
  "description": "PM2 EID Is Discord Dashboard - Lightweight PM2 process management console and supervisor. Developed by Core Red Project.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "check": "biome format --write src test && biome lint src test && tsc --noEmit && bun test",
    "clean": "rm -rf dist node_modules/.cache",
    "prepare": "test -d .git && which husky >/dev/null 2>&1 && husky || true"
  },
  "keywords": [
    "pm2",
    "dashboard",
    "discord",
    "process-manager",
    "bun",
    "hono",
    "htmx",
    "core-red",
    "sxnnyside-project"
  ],
  "author": "Core Red Project <houjou.sxnnyside@sxnnysideproject.com>",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.7",
    "pm2": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write"
    ]
  }
}
