# PM2 EID Dashboard - Environment Configuration
# Copy this file to .env and configure as needed

# Server Configuration
# Port for the dashboard HTTP server (default: 3847)
PM2_EID_PORT=3847

# Node.js Environment
# Options: development, production
NODE_ENV=production

# Operational Flags
# Enable request logging to console (default: true in development)
# PM2_EID_LOG_REQUESTS=true

# Auto-refresh interval in milliseconds (frontend only)
# PM2_EID_AUTO_REFRESH_MS=10000

# Maximum log lines to retrieve per request (default: 100)
# PM2_EID_MAX_LOG_LINES=100

# Notes:
# - This dashboard binds to localhost (127.0.0.1) only
# - Access via SSH tunnel: ssh -L 3847:localhost:3847 user@server
# - No authentication is configured by default
# - See docs/SECURITY.md for authentication implementation guidance
