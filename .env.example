# PM2 EID Dashboard - Environment Configuration
# Copy this file to .env and adjust values

# Server Configuration
PORT=3847
HOST=0.0.0.0
NODE_ENV=development

# Authentication (Optional - if unset, runs in unauthenticated localhost/private network mode)
# AUTH_USER=admin
# AUTH_PASS=your-secure-password

# Webhook Notifications (Optional - Agnostic dispatcher)
# WEBHOOK_URL=https://discord.com/api/webhooks/...
# WEBHOOK_FORMAT=discord    # Options: discord | slack | generic (default: auto-detected)
# WEBHOOK_EVENTS=restart,stop,exit,errored # Comma-separated list or '*' for all

# PM2 Configuration (Useful when running inside Docker with mounted volume)
# PM2_HOME=/root/.pm2
