# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - Git must never diff or normalize them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.riv binary
*.lottie binary

# Lockfiles - marked as generated and quiet in diffs
bun.lock linguist-generated -diff
package-lock.json linguist-generated -diff
pnpm-lock.yaml linguist-generated -diff

